# Deploy-ready environment variables for Cloudflare Pages.
# Real secrets (ADMIN_PASSWORD_HASH, DATABASE_URL for hosted instance) must be set
# in the Cloudflare dashboard or via `wrangler secret put` — never committed.
# DB settings: keep existing `.env.local` for local dev; this file carries the
# production reference. Hosted instance promotion (master-build-plan M10.3) is
# still the owner's action before live traffic.

DATABASE_URL="postgresql://luxeride:<password>@<host>:5432/luxeride"  # Replace with hosted instance before live deploy (M10.3)

NEXT_PUBLIC_SITE_URL="https://luxerideautos.com.ng"

NEXT_PUBLIC_MEDIA_BASE_URL=""

NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

ADMIN_SESSION_SECRET=""
ADMIN_USER=""
ADMIN_PASSWORD_HASH=""
