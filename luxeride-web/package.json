{
  "name": "luxeride-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run media:check && next build",
    "start": "next start",
    "lint": "eslint",
    "media:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/media.mjs --check",
    "media": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/media.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "verify": "tsc --noEmit && eslint . && npm run media:check && npm run seo:check && next build",
    "check:hydration": "node scripts/hydration-check.mjs",
    "postinstall": "prisma generate",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local prisma/seed.mts",
    "db:backup": "bash scripts/db-backup.sh",
    "db:check": "node scripts/db-check.mjs",
    "fitment:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fitment-report.mjs",
    "db:migrate": "node --env-file=.env.local scripts/prisma.mjs migrate dev",
    "db:deploy": "node --env-file=.env.local scripts/prisma.mjs migrate deploy",
    "db:status": "node --env-file=.env.local scripts/prisma.mjs migrate status",
    "db:studio": "node --env-file=.env.local scripts/prisma.mjs studio",
    "db:validate": "node --env-file=.env.local scripts/prisma.mjs validate"
  },
  "prisma": {
    "seed": "node prisma/seed.mts"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15",
    "@prisma/client": "^6.0.0",
    "prisma": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "sharp": "0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
