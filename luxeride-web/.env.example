# Real values go in .env.local, which is never committed. This file is the
# committed record of which variables the app needs; it must never carry a value.
#
# Load order is .env.$(NODE_ENV).local -> .env.local -> .env.$(NODE_ENV) -> .env,
# so .env.local always wins over .env.

# PostgreSQL connection string. Local development uses the cluster installed on
# this machine; production is a hosted provider (still owed — see the E-track).
#   postgresql://luxeride:<password>@localhost:5432/luxeride
DATABASE_URL=

# NEXT_PUBLIC_SITE_URL arrives with storefront-catalog §3.2 (milestone M3) and is
# gated on decision D-05, the production domain. It must be the absolute
# production origin — src/lib/site.ts throws at module load without it, because a
# relative metadataBase makes every canonical and og:image wrong.
