# Real values go in .env.local, which is never committed. This file is the
# committed record of which variables the app needs; it must never carry a value.
#
# Load order is .env.$(NODE_ENV).local -> .env.local -> .env.$(NODE_ENV) -> .env,
# so .env.local always wins over .env.

# PostgreSQL connection string. Local development uses the cluster installed on
# this machine; production is a hosted provider (still owed — see the E-track).
#   postgresql://luxeride:<password>@localhost:5432/luxeride
DATABASE_URL=

# The production origin. D-05 settled on https://luxerideautos.com.ng. It MUST be
# the absolute production origin — src/lib/site.ts throws at module load without
# it, because a relative metadataBase makes every canonical and og:image wrong.
NEXT_PUBLIC_SITE_URL=

# Optional object-storage seam. Empty means images are served from this origin's
# own /public. Setting it (e.g. https://xyz.supabase.co/storage/v1/object/public)
# requires a matching images.remotePatterns entry in next.config.ts.
NEXT_PUBLIC_MEDIA_BASE_URL=

# ── Analytics (`ad-landing-and-tracking` §4–5, milestone M3.7) ────────────────
# Each is read by src/lib/analytics/config.ts and falls back to "", so the app
# builds and runs with none of them set. An unset ID means the provider renders no
# script and sends nothing — which is why the M5 pre-spend gate asserts these are
# set AND visible in page source before any money moves.

# Meta Pixel base code ID, from Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=

# GA4 measurement ID, `G-XXXXXXXXXX`, from the Google tag.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Exists so a TikTok campaign is a config change rather than a code
# change; the provider is already written.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ── Admin console (fitment-engine §7, milestone M9.2) ────────────────────────
# A sign-in page at /admin/login backed by a signed cookie, plus requireAdmin()
# inside every mutating Server Action. HTTP Basic Auth is still accepted on every
# route. One operator, no roles (locked decision 1).
#
# ADMIN_SESSION_SECRET signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing this value ends every signed-in session immediately. It is REQUIRED —
# with no value there is no session, /admin/login says so, and nothing else in the
# console changes. The value is mixed with ADMIN_PASSWORD_HASH when the signing
# key is derived, so rotating the password below also revokes every session.
ADMIN_SESSION_SECRET=

# The operator's username, and the scrypt hash of their password. Generate the
# hash with:
#   node scripts/hash-admin-password.mjs
#
# The dollar signs in the hash MUST be escaped as \$ — Next expands unescaped
# dollars in .env files, so `scrypt$abc...` would be read as `scrypt` followed by
# an undefined variable and arrive silently truncated.
ADMIN_USER=

ADMIN_PASSWORD_HASH=
