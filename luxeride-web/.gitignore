# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example is the point of the example: it is the committed record of
# which variables the app needs, and it must carry no values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database dumps
#
# `scripts/db-backup.sh` writes outside the repo by default (LUXERIDE_BACKUP_DIR,
# $HOME/luxeride-backups). The workspace-write sandbox here cannot write there, so the
# backup was taken into the repo instead — and a pg dump must never be committable.
.db-backups/
